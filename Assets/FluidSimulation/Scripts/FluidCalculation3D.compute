#pragma kernel PredictPositions
#pragma kernel BuildSpatialHash
#pragma kernel BitonicSort
#pragma kernel ClearCellStartIndices
#pragma kernel BuildCellStartIndices
#pragma kernel CalculateDensities
#pragma kernel CalculatePressureAndIntegrate
#pragma kernel GenerateDensityVolume

#define THREADS_PER_GROUP 256
#define VOLUME_THREADS_PER_AXIS 8
#define EMPTY_KEY 0xFFFFFFFFu
#define PI 3.14159265358979323846

struct Particle
{
    float3 position;
    float3 velocity;
};

struct SpatialHashEntry
{
    uint hash;
    uint particleIndex;
    int3 cell;
};

RWStructuredBuffer<Particle> _Particles;
RWStructuredBuffer<float3> _PredictedPositions;
RWStructuredBuffer<float> _Densities;
RWStructuredBuffer<float> _NearDensities;
RWStructuredBuffer<SpatialHashEntry> _SpatialHashEntries;
RWStructuredBuffer<uint> _CellStartIndices;
RWTexture3D<float> _DensityVolume;

uint _ParticleCount;
uint _SortCount;
uint _CellTableSize;

uint _BitonicK;
uint _BitonicJ;

float _DeltaTime;
float3 _Gravity;
float _BoundaryDamping;

float _ParticleMass;
float _TargetDensity;
float _PressureMultiplier;
float _SmoothingRadius;
float _CellSize;

float _PredictionTime;

float3 _BoundsMin;
float3 _BoundsMax;

int3 _DensityVolumeSize;
float3 _VolumeBoundsMin;
float3 _VolumeBoundsMax;
float _VolumeParticleRadius;
float _VolumeDensityScale;

float SpikyKernel(float radius, float distance)
{
    if (distance >= radius)
        return 0;

    float volume = PI * pow(radius, 6) / 15.0;
    return pow(radius - distance, 3) / volume;
}

float SpikyKernelDerivative(float radius, float distance)
{
    if (distance >= radius)
        return 0;

    float volume = PI * pow(radius, 6) / 15.0;
    return -3.0 * pow(radius - distance, 2) / volume;
}

float NearKernel(float radius, float distance)
{
    if (distance >= radius)
        return 0;

    float volume = 4.0 * PI * pow(radius, 7) / 105.0;
    return pow(radius - distance, 4) / volume;
}

float NearKernelDerivative(float radius, float distance)
{
    if (distance >= radius)
        return 0;

    float volume = 4.0 * PI * pow(radius, 7) / 105.0;
    return -4.0 * pow(radius - distance, 3) / volume;
}

int3 PositionToCell(float3 position)
{
    return (int3)floor((position - _BoundsMin) / _CellSize);
}

uint HashCell(int3 cell)
{
    uint x = asuint(cell.x);
    uint y = asuint(cell.y);
    uint z = asuint(cell.z);

    uint hash = x * 15823u + y * 9737333u + z * 440817757u;
    return hash & (_CellTableSize - 1);
}

float DensityToPressure(float density)
{
    return (density - _TargetDensity) * _PressureMultiplier;
}

float NearDensityToPressure(float nearDensity)
{
    return nearDensity * _PressureMultiplier;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void PredictPositions(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _ParticleCount) return;

    Particle particle = _Particles[i];
    _PredictedPositions[i] =
        particle.position + particle.velocity * _PredictionTime;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void BuildSpatialHash(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;

    if (i >= _SortCount)
        return;

    SpatialHashEntry entry;

    if (i >= _ParticleCount)
    {
        entry.hash = EMPTY_KEY;
        entry.particleIndex = 0;
        entry.cell = int3(0, 0, 0);
    }
    else
    {
        int3 cell = PositionToCell(_PredictedPositions[i]);

        entry.hash = HashCell(cell);
        entry.particleIndex = i;
        entry.cell = cell;
    }

    _SpatialHashEntries[i] = entry;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void BitonicSort(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;

    if (i >= _SortCount)
        return;

    uint pairedIndex = i ^ _BitonicJ;

    if (pairedIndex <= i || pairedIndex >= _SortCount)
        return;

    SpatialHashEntry a = _SpatialHashEntries[i];
    SpatialHashEntry b = _SpatialHashEntries[pairedIndex];

    bool ascending = (i & _BitonicK) == 0;
    bool shouldSwap = ascending
        ? a.hash > b.hash
        : a.hash < b.hash;

    if (shouldSwap)
    {
        _SpatialHashEntries[i] = b;
        _SpatialHashEntries[pairedIndex] = a;
    }
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void ClearCellStartIndices(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;

    if (i >= _CellTableSize)
        return;

    _CellStartIndices[i] = EMPTY_KEY;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void BuildCellStartIndices(uint3 id : SV_DispatchThreadID)
{
    uint sortedIndex = id.x;

    if (sortedIndex >= _ParticleCount)
        return;

    SpatialHashEntry current = _SpatialHashEntries[sortedIndex];

    bool isFirstForHash =
        sortedIndex == 0 ||
        _SpatialHashEntries[sortedIndex - 1].hash != current.hash;

    if (isFirstForHash)
        _CellStartIndices[current.hash] = sortedIndex;
}

struct DensityPair
{
    float density;
    float nearDensity;
};

DensityPair CalculateDensityAt(uint particleIndex)
{
    float3 position = _PredictedPositions[particleIndex];
    int3 centerCell = PositionToCell(position);

    float density = 0;
    float nearDensity = 0;
    float radiusSq = _SmoothingRadius * _SmoothingRadius;

    for (int z = -1; z <= 1; z++)
    {
        for (int y = -1; y <= 1; y++)
        {
            for (int x = -1; x <= 1; x++)
            {
                int3 targetCell = centerCell + int3(x, y, z);
                uint targetHash = HashCell(targetCell);
                uint startIndex = _CellStartIndices[targetHash];

                if (startIndex == EMPTY_KEY)
                    continue;

                for (uint sortedIndex = startIndex;
                     sortedIndex < _ParticleCount;
                     sortedIndex++)
                {
                    SpatialHashEntry entry =
                        _SpatialHashEntries[sortedIndex];

                    if (entry.hash != targetHash)
                        break;

                    if (any(entry.cell != targetCell))
                        continue;

                    uint otherIndex = entry.particleIndex;
                    float3 offset =
                        _PredictedPositions[otherIndex] - position;

                    float distanceSq = dot(offset, offset);

                    if (distanceSq >= radiusSq)
                        continue;

                    float distance = sqrt(distanceSq);

                    density += _ParticleMass *
                        SpikyKernel(_SmoothingRadius, distance);

                    nearDensity += _ParticleMass *
                        NearKernel(_SmoothingRadius, distance);
                }
            }
        }
    }

    DensityPair result;

    result.density = density;
    result.nearDensity = nearDensity;
    return result;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void CalculateDensities(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;

    if (i >= _ParticleCount)
        return;

    DensityPair pair = CalculateDensityAt(i);
    _Densities[i] = pair.density;
    _NearDensities[i] = pair.nearDensity;
}

float3 CalculatePressureForce(uint particleIndex)
{
    float3 position = _PredictedPositions[particleIndex];
    int3 centerCell = PositionToCell(position);

    float densityI = max(_Densities[particleIndex], 1e-6);
    float nearDensityI = max(_NearDensities[particleIndex], 1e-6);
    float pressureI = DensityToPressure(densityI);
    float nearPressureI = NearDensityToPressure(nearDensityI);

    float3 pressureForce = 0;
    float radiusSq = _SmoothingRadius * _SmoothingRadius;

    for (int z = -1; z <= 1; z++)
    {
        for (int y = -1; y <= 1; y++)
        {
            for (int x = -1; x <= 1; x++)
            {
                int3 targetCell = centerCell + int3(x, y, z);
                uint targetHash = HashCell(targetCell);
                uint startIndex = _CellStartIndices[targetHash];

                if (startIndex == EMPTY_KEY)
                    continue;

                for (uint sortedIndex = startIndex;
                     sortedIndex < _ParticleCount;
                     sortedIndex++)
                {
                    SpatialHashEntry entry =
                        _SpatialHashEntries[sortedIndex];

                    if (entry.hash != targetHash)
                        break;

                    if (any(entry.cell != targetCell))
                        continue;

                    uint otherIndex = entry.particleIndex;

                    if (otherIndex == particleIndex)
                        continue;

                    float3 offset =
                        _PredictedPositions[otherIndex] - position;

                    float distanceSq = dot(offset, offset);

                    if (distanceSq <= 1e-10 ||
                        distanceSq >= radiusSq)
                    {
                        continue;
                    }

                    float distance = sqrt(distanceSq);
                    float3 direction = offset / distance;

                    float densityJ =
                        max(_Densities[otherIndex], 1e-6);

                    float pressureJ = DensityToPressure(densityJ);
                    float sharedPressure =
                        (pressureI + pressureJ) * 0.5;

                    float slope =
                        SpikyKernelDerivative(
                            _SmoothingRadius,
                            distance);

                    pressureForce +=
                        direction *
                        (sharedPressure *
                         slope *
                         _ParticleMass /
                         densityJ);

                    float nearDensityJ =
                        max(_NearDensities[otherIndex], 1e-6);

                    float nearPressureJ =
                        NearDensityToPressure(nearDensityJ);

                    float sharedNearPressure =
                        (nearPressureI + nearPressureJ) * 0.5;

                    slope =
                        NearKernelDerivative(
                            _SmoothingRadius,
                            distance);

                    pressureForce +=
                        direction *
                        (sharedNearPressure *
                         slope *
                         _ParticleMass /
                         densityJ);
                }
            }
        }
    }

    return pressureForce;
}

[numthreads(THREADS_PER_GROUP, 1, 1)]
void CalculatePressureAndIntegrate(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;

    if (i >= _ParticleCount)
        return;

    Particle particle = _Particles[i];

    float density = max(_Densities[i], 1e-6);
    float3 pressureForce = CalculatePressureForce(i);
    float3 pressureAcceleration = pressureForce / density;

    particle.velocity += pressureAcceleration * _DeltaTime;
    particle.velocity += _Gravity * _DeltaTime;

    particle.position += particle.velocity * _DeltaTime;

    float wallMargin = 0.05;
    float3 minPos = _BoundsMin + wallMargin;
    float3 maxPos = _BoundsMax - wallMargin;

    if (particle.position.x < minPos.x)
    {
        particle.position.x = minPos.x;

        if (particle.velocity.x < 0.0)
            particle.velocity.x =
                -particle.velocity.x * _BoundaryDamping;
    }
    else if (particle.position.x > maxPos.x)
    {
        particle.position.x = maxPos.x;

        if (particle.velocity.x > 0.0)
            particle.velocity.x =
                -particle.velocity.x * _BoundaryDamping;
    }

    if (particle.position.y < minPos.y)
    {
        particle.position.y = minPos.y;

        if (particle.velocity.y < 0.0)
            particle.velocity.y =
                -particle.velocity.y * _BoundaryDamping;
    }
    else if (particle.position.y > maxPos.y)
    {
        particle.position.y = maxPos.y;

        if (particle.velocity.y > 0.0)
            particle.velocity.y =
                -particle.velocity.y * _BoundaryDamping;
    }

    if (particle.position.z < minPos.z)
    {
        particle.position.z = minPos.z;

        if (particle.velocity.z < 0.0)
            particle.velocity.z =
                -particle.velocity.z * _BoundaryDamping;
    }
    else if (particle.position.z > maxPos.z)
    {
        particle.position.z = maxPos.z;

        if (particle.velocity.z > 0.0)
            particle.velocity.z =
                -particle.velocity.z * _BoundaryDamping;
    }

    _Particles[i] = particle;
}

[numthreads(VOLUME_THREADS_PER_AXIS, VOLUME_THREADS_PER_AXIS, VOLUME_THREADS_PER_AXIS)]
void GenerateDensityVolume(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _DensityVolumeSize.x ||
        id.y >= _DensityVolumeSize.y ||
        id.z >= _DensityVolumeSize.z)
    {
        return;
    }

    float3 uvw =
        ((float3)id + 0.5) / max((float3)_DensityVolumeSize, 1.0);

    float3 worldPosition =
        lerp(_VolumeBoundsMin, _VolumeBoundsMax, uvw);

    float radius =
        max(_VolumeParticleRadius, 1e-5);

    float radiusSq = radius * radius;
    float density = 0;

    for (uint i = 0; i < _ParticleCount; i++)
    {
        float3 offset =
            worldPosition - _Particles[i].position;

        float distanceSq = dot(offset, offset);

        if (distanceSq >= radiusSq)
            continue;

        float distance = sqrt(distanceSq);
        float q = 1.0 - distance / radius;

        density += q * q * q;
    }

    _DensityVolume[id] = density * _VolumeDensityScale;
}
